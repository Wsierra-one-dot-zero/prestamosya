{
  "stack-outputs": [
    "${ENVIRONMENT_ID}-Base-Infraestructure-Stack"
  ],
  "deploy": {
    "stack-name": "${ENVIRONMENT_ID}-loans-Stack",
    "Parameters": [
      {
        "ParameterKey": "EnvironmentName",
        "ParameterValue": "${ENVIRONMENT_ID}"
      },
      {
        "ParameterKey": "VpcId",
        "ParameterValue": "${${ENVIRONMENT_ID}-Base-Infraestructure-Stack:VPCId}"
      },
      {
        "ParameterKey": "Subnet1",
        "ParameterValue": "${${ENVIRONMENT_ID}-Base-Infraestructure-Stack:PublicSubnet1}"
      },
      {
        "ParameterKey": "Subnet2",
        "ParameterValue": "${${ENVIRONMENT_ID}-Base-Infraestructure-Stack:PublicSubnet2}"
      },
      {
        "ParameterKey": "SecurityGroup",
        "ParameterValue": "${${ENVIRONMENT_ID}-Base-Infraestructure-Stack:SecurityGroupId}"
      },
      {
        "ParameterKey": "LoadBalancer",
        "ParameterValue": "${${ENVIRONMENT_ID}-Base-Infraestructure-Stack:ALBDNSName}"
      },
      {
        "ParameterKey": "LoadBalancerARN",
        "ParameterValue": "${${ENVIRONMENT_ID}-Base-Infraestructure-Stack:ALBArn}"
      },
      {
        "ParameterKey": "ClusterName",
        "ParameterValue": "${${ENVIRONMENT_ID}-Base-Infraestructure-Stack:ECSClusterName}"
      },
      {
        "ParameterKey": "ECRRepository",
        "ParameterValue": "public.ecr.aws/p8l8p7u7/genos/dev/loans-app"
      },
      {
        "ParameterKey": "ContainerPort",
        "ParameterValue": "8000"
      },
      {
        "ParameterKey": "DesiredCount",
        "ParameterValue": "1"
      },
      {
        "ParameterKey": "TaskCpu",
        "ParameterValue": "256"
      },
      {
        "ParameterKey": "TaskMemory",
        "ParameterValue": "512"
      },
      {
        "ParameterKey": "SecretName",
        "ParameterValue": "${ENVIRONMENT_ID}/loans/data/credentials"
      },
      {
        "ParameterKey": "TargetGroupARN",
        "ParameterValue": "${${ENVIRONMENT_ID}-Base-Infraestructure-Stack:TargetGroupARN}"
      }
    ]
  }
}
